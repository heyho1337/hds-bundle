{# admin/form/image_upload_with_preview.html.twig #}

{% set image = form.parent.vars.data.image ?? null %}

{% if ea.crud.currentAction == 'edit' and image %}
    <div style="margin-bottom: 1rem;">
        <img src="{{ asset('uploads/'~ path ~'/' ~ image ~ '.webp') }}"
             alt="Current image"
             style="max-width: 300px; border: 1px solid #ccc; padding: 4px;"
        />
    </div>
{% endif %}

{{ form_widget(form) }}
