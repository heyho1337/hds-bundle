{{ form_start(form, {
    'action': path('image_upload'),
    'attr': {
        'data-controller': 'image-upload',
        'enctype': 'multipart/form-data',
        'data-turbo-frame': 'modal-frame'
    }
}) }}
    {{ form_row(form.images, {
        attr: {
            'data-image-upload-target': 'input',
            class: 'filepond',
            accept: 'image/*',
            multiple: 'multiple'
        }
    }) }}

    <button class="btn btn-primary">{{ 'Upload'|trans }}</button>

    {{ form_row(form.class, {attr: {'data-image-upload-target': 'classInput'} }) }}
    {{ form_row(form.path, {attr: {'data-image-upload-target': 'pathInput'} }) }}
{{ form_end(form) }}
