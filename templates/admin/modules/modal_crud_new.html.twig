{% extends '@EasyAdmin/crud/new.html.twig' %}

{% block main %}
    <turbo-frame id="modal-frame">
        {{ parent() }}
        {% block page_actions %}
            <div 
                data-controller="admin--ajax-submit admin--turbo-js-load" 
                data-admin--ajax-submit-url-value="{{ url ?? app.request.uri }}"
                data-admin--turbo-js-load-script-url="{{ asset('bundles/easyadmin/field-collection.js') }}"
                >
                <button 
                    type="submit" 
                    data-action="click->admin--ajax-submit#save"
                    class="btn btn-primary"
                >
                    {{ 'Save'|trans }}
                </button>
            </div>
        {% endblock %}
    </turbo-frame>
{% endblock %}
